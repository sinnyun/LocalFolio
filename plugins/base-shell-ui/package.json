{
  "name": "@folio/base-shell-ui",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "DSH native client shell plugin: incremental full-screen workbench overlay + draggable/resizable/maximizable floating panels (ctx.folioShell).",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@folio/base-ui-kit",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "@folio/base-ui-kit"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@folio/base-ui-kit": "workspace:*",
    "@folio/base-contract": "workspace:*",
    "zustand": "^5.0.4"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
