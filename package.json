{
  "name": "localfolio-monorepo",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "LocalFolio — incremental DSH plugin library and suite monorepo built natively on DeepSeek Harness.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "ui:sync": "node scripts/sync-ui-kit.mjs",
    "ui:add": "node scripts/add-ui.mjs",
    "typecheck": "tsc --noEmit",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "pack:workbench": "node scripts/pack-workbench.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run check:artifacts && pnpm run test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^17.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
