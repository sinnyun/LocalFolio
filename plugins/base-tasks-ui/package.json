{
  "name": "@folio/base-tasks-ui",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "LocalFolio shared background tasks client plugin: multi-scope SSE task subscription (useFolioTasks), item-detail subscription (useTaskItems), and unified bottom status bar progress control (<TaskStatusBar>).",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./src/client.tsx",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@folio/base-ui-kit"
      ],
      "external": [
        "@folio/base-ui-kit"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "docs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@folio/base-contract": "workspace:*",
    "@folio/base-ui-kit": "workspace:*",
    "lucide-react": "^0.511.0"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
