{
  "name": "@folio/bundle-suite-all",
  "version": "0.2.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "LocalFolio meta-bundle assembling all independent @folio/* DSH plugins into one installable suite.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "docs"
  ],
  "dependencies": {
    "@folio/core-host-storage": "link:../../plugins/core-host-storage",
    "@folio/core-host-runtime": "link:../../plugins/core-host-runtime",
    "@folio/core-ui-kit": "link:../../plugins/core-ui-kit",
    "@folio/shell-overlay-ui": "link:../../plugins/shell-overlay-ui",
    "@folio/shell-settings-ui": "link:../../plugins/shell-settings-ui",
    "@folio/app-starter-host": "link:../../plugins/app-starter-host",
    "@folio/app-starter-ui": "link:../../plugins/app-starter-ui",
    "@folio/app-gallery-ui": "link:../../plugins/app-gallery-ui",
    "@folio/app-sidebar-ui": "link:../../plugins/app-sidebar-ui",
    "@folio/app-admin-ui": "link:../../plugins/app-admin-ui",
    "@folio/app-studio-ui": "link:../../plugins/app-studio-ui"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
