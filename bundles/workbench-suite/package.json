{
  "name": "@folio/workbench-suite",
  "version": "0.2.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "LocalFolio meta-bundle assembling all independent @folio/* DSH plugins into one installable suite.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "docs"
  ],
  "dependencies": {
    "@folio/base-storage-host": "link:../../plugins/base-storage-host",
    "@folio/base-runtime-host": "link:../../plugins/base-runtime-host",
    "@folio/base-ui-kit": "link:../../plugins/base-ui-kit",
    "@folio/base-shell-ui": "link:../../plugins/base-shell-ui",
    "@folio/base-frame-ui": "link:../../plugins/base-frame-ui",
    "@folio/base-settings-ui": "link:../../plugins/base-settings-ui",
    "@folio/bridge-frame-test-ui": "link:../../plugins/bridge-frame-test-ui",
    "@folio/test-overview-host": "link:../../plugins/test-overview-host",
    "@folio/test-overview-ui": "link:../../plugins/test-overview-ui",
    "@folio/test-gallery-ui": "link:../../plugins/test-gallery-ui",
    "@folio/test-sidebar-ui": "link:../../plugins/test-sidebar-ui",
    "@folio/test-shadcn-admin-ui": "link:../../plugins/test-shadcn-admin-ui",
    "@folio/test-studio-admin-ui": "link:../../plugins/test-studio-admin-ui"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
