{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./plugins/base-ui-kit/src/*"]
    }
  },
  "include": [
    "libs/*/src/**/*.ts",
    "libs/*/src/**/*.tsx",
    "plugins/*/src/**/*.ts",
    "plugins/*/src/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/lib", "**/dist"]
}
