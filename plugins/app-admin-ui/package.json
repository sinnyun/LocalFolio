{
  "name": "@folio/app-admin-ui",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "shadcn-admin ported into a LocalFolio workspace plugin: collapsible icon sidebar, command search, theme switch, dashboard with charts, tasks and users data tables, app integrations, chats inbox and settings pages.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@folio/core-ui-kit",
        "@folio/shell-overlay-ui"
      ],
      "external": [
        "@folio/core-ui-kit"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@folio/core-ui-kit": "workspace:*",
    "@folio/lib-shared-contract": "workspace:*",
    "lucide-react": "^0.511.0"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
