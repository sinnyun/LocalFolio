{
  "name": "@folio/workspace-canvas-ui",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "LocalFolio Canvas workspace powered by tldraw: left board list sidebar, full edge-to-edge tldraw canvas, link-only local image management, automatic browser-drop import into a managed imports folder, LOD proxy resolution, and broken-link relink mini-panel.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@folio/base-ui-kit",
        "@folio/base-shell-ui",
        "@folio/base-frame-ui"
      ],
      "external": [
        "@folio/base-ui-kit"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "docs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@folio/base-contract": "workspace:*",
    "@folio/base-ui-kit": "workspace:*",
    "@tldraw/assets": "5.6.2",
    "lucide-react": "^0.511.0",
    "tldraw": "5.6.2"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
