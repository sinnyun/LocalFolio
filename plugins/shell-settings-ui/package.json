{
  "name": "@folio/shell-settings-ui",
  "version": "0.2.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "DSH settings.section plugin rendering LocalFolio's dual-layer plugin & extension governance view.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@folio/core-ui-kit",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": [
        "@folio/core-ui-kit"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@folio/core-ui-kit": "workspace:*",
    "@folio/lib-shared-contract": "workspace:*"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
